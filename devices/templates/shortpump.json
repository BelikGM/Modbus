{
  "id": "shortpump",
  "name": "hz",
  "family": "delfa",
  "familyLabel": "",
  "connection": {
    "slaveId": 1,
    "baudRate": 9600,
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none",
    "protocol": "modbus-rtu"
  },
  "groups": [
    {
      "id": "F2",
      "name": "F2 — Параметры двигателя",
      "description": "Настройки пуска, останова и характеристик электродвигателя",
      "params": [
        {
          "id": "F2.00",
          "name": "Способ запуска двигателя",
          "register": 200,
          "access": "read-write",
          "type": "enum",
          "options": {
            "0": "Обычный пуск",
            "1": "Пуск с поиском частоты (подхват вращающегося электродвигателя)"
          },
          "default": 0
        },
        {
          "id": "F2.01",
          "name": "Способ остановки двигателя",
          "register": 201,
          "access": "read-write",
          "type": "enum",
          "options": {
            "0": "Остановка с замедлением",
            "1": "Остановка на выбеге"
          },
          "default": 0
        },
        {
          "id": "F2.02",
          "name": "Частота запуска",
          "register": 202,
          "access": "read-write",
          "type": "float",
          "scale": 0.01,
          "unit": "Гц",
          "min": 0.1,
          "max": 10,
          "step": 0.01,
          "default": 0.5
        },
        {
          "id": "F2.03",
          "name": "Частота остановки",
          "register": 203,
          "access": "read-write",
          "type": "float",
          "scale": 0.01,
          "unit": "Гц",
          "min": 0.1,
          "max": 10,
          "step": 0.01,
          "default": 0.5
        },
        {
          "id": "F2.04",
          "name": "Сила торможения постоянным током при пуске",
          "register": 204,
          "access": "read-write",
          "type": "integer",
          "unit": "% от F2.10",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 32
        },
        {
          "id": "F2.05",
          "name": "Время торможения постоянным током при пуске",
          "register": 205,
          "access": "read-write",
          "type": "float",
          "scale": 0.1,
          "unit": "сек",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "default": 0
        },
        {
          "id": "F2.06",
          "name": "Сила торможения постоянным током при остановке",
          "register": 206,
          "access": "read-write",
          "type": "integer",
          "unit": "% от F2.10",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 32
        },
        {
          "id": "F2.07",
          "name": "Время торможения постоянным током при остановке",
          "register": 207,
          "access": "read-write",
          "type": "float",
          "scale": 0.1,
          "unit": "сек",
          "min": 0,
          "max": 100,
          "step": 0.1,
          "default": 0
        },
        {
          "id": "F2.08",
          "name": "Уровень увеличения момента",
          "register": 208,
          "access": "read-write",
          "type": "float",
          "scale": 0.1,
          "unit": "%",
          "min": 0,
          "max": 20,
          "step": 0.1,
          "default": 0
        },
        {
          "id": "F2.09",
          "name": "Номинальное напряжение электродвигателя",
          "register": 209,
          "access": "read-write",
          "type": "float",
          "scale": 0.1,
          "unit": "В",
          "min": 0,
          "max": 500,
          "default": 380
        },
        {
          "id": "F2.10",
          "name": "Номинальный ток электродвигателя",
          "register": 210,
          "access": "read-write",
          "type": "float",
          "scale": 0.1,
          "unit": "А",
          "min": 0,
          "max_ref": "Номинальный ток ПЧ",
          "step": 0.1,
          "default": "Зависит от модели ПЧ"
        },
        {
          "id": "F2.11",
          "name": "Ток холостого хода электродвигателя",
          "register": 211,
          "access": "read-write",
          "type": "integer",
          "unit": "% от F2.10",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "id": "F2.12",
          "name": "Номинальная скорость вращения электродвигателя",
          "register": 212,
          "access": "read-write",
          "type": "integer",
          "unit": "об/мин",
          "min": 0,
          "max": 60000,
          "default": 1420
        },
        {
          "id": "F2.13",
          "name": "Количество полюсов",
          "register": 213,
          "access": "read-write",
          "type": "integer",
          "min": 0,
          "max": 20,
          "default": 4
        },
        {
          "id": "F2.14",
          "name": "Номинальное скольжение электродвигателя",
          "register": 214,
          "access": "read-write",
          "type": "float",
          "scale": 0.01,
          "unit": "%",
          "min": 0,
          "max": 10,
          "step": 0.01,
          "default": 2.5
        },
        {
          "id": "F2.15",
          "name": "Номинальная частота напряжения питания электродвигателя",
          "register": 215,
          "access": "read-write",
          "type": "float",
          "scale": 0.1,
          "unit": "Гц",
          "min": 0,
          "max": 400,
          "default": 50
        }
      ]
    }
  ],
  "errorCodes": {
    "0": "Нет ошибки",
    "1": "Перегрузка по току при разгоне",
    "2": "Перегрузка по току при торможении",
    "3": "Перегрузка по току при постоянной скорости",
    "4": "Перенапряжение при разгоне",
    "5": "Перенапряжение при торможении",
    "6": "Перенапряжение при постоянной скорости",
    "7": "Пониженное напряжение шины DC",
    "8": "Перегрев преобразователя",
    "9": "Перегрев двигателя",
    "10": "Перегрузка по току двигателя",
    "11": "Перегрузка ПЧ",
    "12": "Обрыв входной фазы",
    "13": "Обрыв выходной фазы",
    "14": "Ошибка памяти EEPROM",
    "15": "Ошибка процессора",
    "16": "Ошибка связи RS-485",
    "17": "Ошибка датчика тока",
    "18": "Ошибка обратной связи ПИД",
    "19": "Потеря нагрузки",
    "20": "Ошибка автонастройки параметров двигателя",
    "23": "Перегрев радиатора",
    "24": "Короткое замыкание на землю",
    "25": "Блокировка двигателя (заклинивание)",
    "30": "Внешняя авария (вход DI)"
  },
  "custom": true
}