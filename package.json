{
  "name": "modbus-controller",
  "version": "1.0.0",
  "description": "Modbus RTU / RS-485 device manager",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build:frontend": "cd frontend && npm run build && node -e \"const fs=require('fs'); fs.rmSync('../backend/frontend-dist',{recursive:true,force:true}); fs.cpSync('dist','../backend/frontend-dist',{recursive:true})\"",
    "build:backend": "cd backend && npm run build",
    "rebuild:native": "electron-rebuild -f -w serialport -m backend",
    "build": "npm run build:frontend && npm run build:backend",
    "electron:dev": "npm run build && npx electron .",
    "dist:win": "npm run build && npx electron-builder --win",
    "dist:mac": "npm run build && npx electron-builder --mac",
    "dist:linux": "npm run build && npx electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.modbus.controller",
    "productName": "Modbus Controller",
    "afterPack": "./electron/afterPack.js",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      { "from": "backend", "to": "backend" },
      { "from": "devices", "to": "devices" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["ru_RU", "en_US"],
      "language": "1049"
    }
  }
}
