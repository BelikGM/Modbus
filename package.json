{
  "name": "modbus-controller",
  "private": true,
  "version": "1.0.2",
  "description": "Modbus RTU / RS-485 device manager",
  "author": {
    "name": "BelikGM",
    "email": "belikgeorgij@gmail.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "cd frontend && npm run build && node -e \"const fs=require('fs'); fs.rmSync('../backend/frontend-dist',{recursive:true,force:true}); fs.cpSync('dist','../backend/frontend-dist',{recursive:true})\"",
    "build:backend": "cd backend && npm run build",
    "rebuild:native": "electron-rebuild -f -w serialport -m backend",
    "build": "npm run build:frontend && npm run build:backend",
    "electron:dev": "npm run build && npx electron .",
    "version:bump": "node scripts/bump-version.js",
    "dist:win": "npm run version:bump && npm run build && npx electron-builder --win",
    "dist:mac": "npm run version:bump && npm run build && npx electron-builder --mac",
    "dist:linux": "npm run version:bump && npm run build && npx electron-builder --linux"
  },
  "build": {
    "appId": "com.modbus.controller",
    "productName": "Modbus Controller",
    "afterPack": "./electron/afterPack.js",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "devices",
        "to": "devices"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "extraFiles": [
      {
        "from": "build/extra/README.txt",
        "to": "README.txt"
      },
      {
        "from": "build/extra/drivers",
        "to": "drivers"
      }
    ]
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9"
  }
}
